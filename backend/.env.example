# Spring Boot Backend - Environment Configuration Template
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MongoDB Atlas Connection URI & Database Name
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=aireadiness

# JWT Security Key & Expiration (256-bit key for HMAC-SHA)
JWT_SECRET=your-256-bit-secret-key-goes-here
JWT_EXPIRATION=86400000

# OpenAI API Configuration (Required for AI Review & RAG Embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
